# Blog demo: only the Unity project and Git configuration are published.
/*
!/.gitignore
!/.gitattributes
!/Assets/
!/Packages/
!/ProjectSettings/

# Packages are restored by Unity; do not vendor external tools or caches.
/Packages/*
!/Packages/manifest.json
!/Packages/packages-lock.json
/ProjectSettings/Packages/
/ProjectSettings/VersionControlSettings.asset
/ProjectSettings/SceneTemplateSettings.json

# Documents, agent configuration, external tooling, and credentials.
[Dd]oc/
[Dd]ocs/
[Dd]ocumentation/
[Tt]ools/
.vscode/
.idea/
.vs/
.dsh/
.claude/
.codex/
*.md
*.md.meta
*.pdf
*.pdf.meta
*.docx
*.docx.meta
*.pptx
*.pptx.meta
*.xlsx
*.xlsx.meta
.env
.env.*
*.pem
*.key
*.p12
*.pfx

# Unity-generated caches, projects, builds, and logs.
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/
/[Mm]emoryCaptures/
/[Rr]ecordings/

# Generated files and external editor integrations inside Assets.
/Assets/AssetStoreTools*/
/Assets/AssetStoreTools*.meta
/Assets/Plugins/Editor/JetBrains*/
/Assets/Plugins/Editor/JetBrains*.meta
/Assets/MCPForUnity/
/Assets/MCPForUnity.meta
/Assets/Editor/MCPForUnity/
/Assets/Editor/MCPForUnity.meta
*.csproj
*.sln
*.user
*.userprefs
*.tmp
*.log
*.pdb
*.pdb.meta
*.mdb
*.mdb.meta
.DS_Store
Thumbs.db
